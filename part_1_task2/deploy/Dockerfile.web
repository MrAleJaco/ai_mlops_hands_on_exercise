# syntax=docker/dockerfile:1.7
# Stage 1 builds the static bundle with Node; stage 2 serves it with an
# unprivileged nginx (uid 101, port 8080) and proxies /api to the FastAPI
# service, so the browser only ever sees one origin.

# ---------- build ----------
FROM node:22-alpine AS build
WORKDIR /app
COPY part_1_task2/app/package.json part_1_task2/app/package-lock.json ./
RUN npm ci
COPY part_1_task2/app/ ./
RUN npm run build

# ---------- runtime ----------
FROM nginxinc/nginx-unprivileged:1.27-alpine AS runtime
COPY part_1_task2/deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:8080/ || exit 1
